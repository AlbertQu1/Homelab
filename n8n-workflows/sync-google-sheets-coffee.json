    {
      "parameters": {
        "jsCode": "const csvText = $input.first().json.data;\nconst lines = csvText.trim().split('\\n');\n\nfunction parsearLineaCSV(linea) {\n  const resultado = [];\n  let actual = '';\n  let dentroDeComillas = false;\n  for (let i = 0; i < linea.length; i++) {\n    const char = linea[i];\n    if (char === '\"') { dentroDeComillas = !dentroDeComillas; }\n    else if (char === ',' && !dentroDeComillas) { resultado.push(actual); actual = ''; }\n    else { actual += char; }\n  }\n  resultado.push(actual);\n  return resultado;\n}\n\nfunction convertirFecha(fechaStr) {\n  if (!fechaStr || fechaStr.trim() === '') return null;\n  const valor = fechaStr.trim();\n  if (/^\\d{4}-\\d{2}-\\d{2}$/.test(valor)) return valor;\n  const partes = valor.split('/');\n  if (partes.length !== 3) return null;\n  let [dia, mes, anio] = partes;\n  if (anio.length === 2) anio = '20' + anio;\n  return `${anio}-${mes.padStart(2,'0')}-${dia.padStart(2,'0')}`;\n}\n\nconst rows = lines.slice(1)\n  .filter(line => line.trim() !== '')\n  .map(line => {\n    const v = parsearLineaCSV(line);\n    return {\n      folio_sheet: parseInt(v[0]) || null,\n      fecha: convertirFecha(v[1]),\n      mantenimiento: v[2]?.trim() || null,\n      tazas: parseInt(v[3]) || 0\n    };\n  });\n\nreturn rows.map(r => ({ json: r }));"
